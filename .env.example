APP_NAME=ActionOS
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://actionos:actionos_dev@localhost:5432/actionos
TEST_DATABASE_URL=postgresql+psycopg://actionos:actionos_dev@localhost:5432/actionos_test

SECRET_KEY=change-me-in-production-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

LOG_LEVEL=INFO

# Model / AI Layer (Phase 3)
# Routing: auto | prefer_local | prefer_cloud | force_local | force_cloud
MODEL_ROUTING_STRATEGY=auto
MODEL_PRIVACY_FIRST=true

# Cloud provider — OPTIONAL. App still starts without these (falls back to
# the built-in deterministic "fake" provider used for tests).
# Set OPENAI_API_KEY only if you have a real OpenAI (or compatible) account.
# Production NOTE: never commit .env or real API keys to version control.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
